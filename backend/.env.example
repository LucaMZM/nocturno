PORT=3000
NODE_ENV=development
# Ajusta usuario, password, host y base a tu PostgreSQL local.
DATABASE_URL=postgresql://nocturno:change-me@localhost:5432/nocturno
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Genera dos valores diferentes y aleatorios de al menos 32 caracteres.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Opcionales para compras de pago; usa solo claves test en desarrollo.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EVENT_GALLERY_MAX_IMAGES=24

# Yomogan: no paid provider is required. Run Ollama on the API host or private network.
YOMOGAN_AVATAR_PATH=/yomogan/avatar.png
YOMOGAN_PROVIDER=ollama
YOMOGAN_CHAT_URL=http://127.0.0.1:11434
YOMOGAN_MODEL=qwen3:4b
YOMOGAN_EMBED_PROVIDER=ollama
YOMOGAN_EMBED_URL=http://127.0.0.1:11434
YOMOGAN_EMBED_MODEL=embeddinggemma
YOMOGAN_TIMEOUT_MS=60000
# Optional compatible provider: base URL includes /v1, models must support JSON schema.
# YOMOGAN_API_KEY=
# YOMOGAN_EMBED_API_KEY=
