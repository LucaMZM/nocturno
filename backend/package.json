{
  "name": "nocturno-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,json,sql src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "NODE_ENV=test node --test",
    "check": "find src test -name '*.js' -exec node --check {} \\;",
    "db:index:yomogan": "node tools/index-yomogan.js",
    "db:audit": "node tools/audit-integrity.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
